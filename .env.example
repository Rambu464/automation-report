# ==============================================================================
# Newstent — Analyst Workflow Automation Tool (Environment Configuration)
# Mengacu pada SRS.md (Bab 2 & 8) dan SAD.md (Bab 2, 5, & 7)
# ==============================================================================

# --- Primary Cloud AI: DeepSeek API (Default — Off-Peak < 08.00 WIB diskon 50%) ---
DEEPSEEK_API_KEY=isi_api_key_deepseek_anda
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_PRIMARY_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

# --- Secondary Cloud AI Fallback: Qwen via OpenRouter / Compatible Endpoint ---
OPENROUTER_API_KEY=isi_api_key_openrouter_anda
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# --- Fast Open-Source Fallback: Llama 3.3 70B via Groq ---
GROQ_API_KEY=isi_api_key_groq_anda
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional Backup: Google Gemini ---
GEMINI_API_KEY=isi_api_key_gemini_anda
GEMINI_MODEL=gemini-2.5-flash

# --- AI Engine Tuning ---
AI_BATCH_SIZE=30
AI_MAX_CONCURRENCY=5
AI_MAX_RETRIES=2

# --- Local Storage & SQLite State DB ---
SQLITE_DB_PATH=data/newstent_state.db
DATA_DIR=data
CLIENTS_DIR=clients

# --- Local Web App (FastAPI Backend + Next.js Frontend) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
