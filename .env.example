# Token JWT dari Newstensity
NEWSTENSITY_JWT_TOKEN=isi_token_jwt_newstensity_anda_di_sini

# Daftar Topic ID (pisahkan dengan koma jika lebih dari satu)
DEFAULT_TOPIC_IDS=5bb2f509c1f8ca1770b19e62

# Konfigurasi Rentang Tanggal Default (Format: YYYY-MM-DD HH:MM:SS)
DEFAULT_DATE_FROM=2026-11-09 00:00:00
DEFAULT_DATE_TO=2026-11-16 23:59:59

# Jumlah maksimal berita/report yang diambil per Topic
MAX_NEWS_PER_TOPIC=20

# Konfigurasi LLM (gemini / openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=isi_api_key_gemini_anda
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=isi_api_key_openai_anda
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
